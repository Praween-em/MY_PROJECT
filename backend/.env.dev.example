# Backend — DEV / TEST environment (used by `npm run deploy` → stage dev)
# Copy:  cp .env.dev.example .env.dev
# Paste your Razorpay TEST credentials from dashboard.razorpay.com → API Keys
#
# Webhook secret: create webhook AFTER first deploy, then paste secret here and redeploy.

AWS_REGION=ap-south-1
DYNAMODB_TABLE=primeclicker-users-dev
PORT=3000
NODE_ENV=development

RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
