# SUPER RIDEX backend — local / Railway
#
# 1. Create a Postgres database (local or Railway)
# 2. Copy this file to .env
# 3. npm install
# 4. npm run migrate
# 5. npm run seed:admin -- admin@example.com 'YourPassword'
# 6. npm run dev
#
# Deploy to Railway later with the same env vars + Dockerfile.

PORT=3000
NODE_ENV=development

# Required — PostgreSQL connection string
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/superridex
# Set true on Railway / managed Postgres that requires SSL
DATABASE_SSL=false

# Razorpay
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# MSG91 — server authkey only (from dashboard Authkey dropdown, e.g. SuperRIdex)
# Never put this in the mobile app / EXPO_PUBLIC_* vars
MSG91_AUTHKEY=

# Admin panel session signing
ADMIN_JWT_SECRET=change-me-to-a-long-random-string

# Optional defaults for seed script
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
