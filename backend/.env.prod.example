# Backend — PRODUCTION / LIVE environment (used by `npm run deploy:prod` → stage prod)
# Copy:  cp .env.prod.example .env.prod
# Paste your Razorpay LIVE credentials (after KYC approval).
#
# After switching to live keys, run:  npm run deploy:prod
# No code changes needed — only this file + redeploy.

AWS_REGION=ap-south-1
DYNAMODB_TABLE=primeclicker-users-prod
PORT=3000
NODE_ENV=production

RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
