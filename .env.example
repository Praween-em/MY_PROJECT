# Prime Clicker — App environment
# Copy to .env and paste your Razorpay TEST keys.
# Switch to live: change EXPO_PUBLIC_RAZORPAY_MODE=live and use rzp_live_* key, then rebuild app.
#
#   cp .env.example .env

# ─── Mode ─────────────────────────────────────────────────────────────────────
# test = Razorpay test mode (no real money)   |   live = production payments
EXPO_PUBLIC_RAZORPAY_MODE=test

# ─── Backend API ──────────────────────────────────────────────────────────────
# Before deploy: http://localhost:3000  OR  http://<your-lan-ip>:3000 for phone testing
# After deploy:  paste API Gateway URL from `cd backend && npm run deploy`
EXPO_PUBLIC_API_URL=http://localhost:3000

# ─── Razorpay publishable Key ID (safe in app — NOT the secret) ─────────────────
# TEST keys start with rzp_test_   |   LIVE keys start with rzp_live_
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
