# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (never commit secrets)
.env
.env.dev
.env.prod
backend/.env
backend/.env.dev
backend/.env.prod
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
# Local DynamoDB (huge JARs - never commit)
backend/.dynamodb/
backend/node_modules/

# UI dumps / scratch
dump_*.xml
dump_ui.js

# Build / caches
*.apk
*.aab
.gradle/
**/build/
!src/**/build/

# Agent / IDE
.cursor/
agent-transcripts/

# Accidental media dumps
assets/WhatsApp*.jpeg
assets/WhatsApp*.jpg

